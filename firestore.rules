rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function memberPath(tenantId, userId) {
      return /databases/$(database)/documents/tenantMembers/$(tenantId + '_' + userId);
    }

    function tenantPath(tenantId) {
      return /databases/$(database)/documents/tenants/$(tenantId);
    }

    function isActiveMember(tenantId) {
      return isAuthenticated()
        && exists(memberPath(tenantId, request.auth.uid))
        && get(memberPath(tenantId, request.auth.uid)).data.active == true;
    }

    function isTenantAdmin(tenantId) {
      return isActiveMember(tenantId)
        && get(memberPath(tenantId, request.auth.uid)).data.role
          in ['owner', 'admin'];
    }

    function projectMemberPath(tenantId) {
      return memberPath(tenantId, request.auth.uid);
    }

    function canProjectAction(tenantId, action) {
      return isAuthenticated()
        && isActiveMember(tenantId)
        && (
          get(projectMemberPath(tenantId)).data.role == 'owner'
          ||
          (
            get(projectMemberPath(tenantId)).data.keys()
              .hasAny(['permissions'])
            && get(projectMemberPath(tenantId)).data.permissions is map
            && get(projectMemberPath(tenantId))
              .data.permissions.get(action, false) == true
          )
        );
    }

    function validProject(data) {
      return data.keys().hasAll([
          'tenantId', 'name', 'description', 'clientName',
          'responsibleUserId', 'status', 'priority',
          'startDate', 'dueDate', 'createdBy',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'tenantId', 'name', 'description', 'clientName', 'clientId',
          'responsibleUserId', 'status', 'priority',
          'startDate', 'dueDate', 'createdBy',
          'createdAt', 'updatedAt'
        ])
        && data.tenantId is string
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 150
        && data.description is string
        && data.description.size() <= 3000
        && data.clientName is string
        && data.clientName.size() <= 150
        && (
          !data.keys().hasAny(['clientId'])
          || data.clientId == null
          || (
            data.clientId is string
            && data.clientId.size() > 0
          )
        )
        && (
          data.responsibleUserId == null
          || data.responsibleUserId is string
        )
        && data.status in [
          'planned', 'in_progress', 'completed', 'cancelled'
        ]
        && data.priority in [
          'low', 'medium', 'high', 'critical'
        ]
        && (
          data.startDate == null
          || data.startDate is timestamp
        )
        && (
          data.dueDate == null
          || data.dueDate is timestamp
        )
        && (
          data.startDate == null
          || data.dueDate == null
          || data.dueDate >= data.startDate
        )
        && data.createdBy is string
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validProjectResponsible(tenantId, userId) {
      return userId == null
        || (
          userId is string
          && exists(
            /databases/$(database)/documents/tenantMembers/$(tenantId + '_' + userId)
          )
          && get(
            /databases/$(database)/documents/tenantMembers/$(tenantId + '_' + userId)
          ).data.active == true
        );
    }

    function validProjectClient(data) {
      return !data.keys().hasAny(['clientId'])
        || data.clientId == null
        || (
          data.clientId is string
          && exists(
            /databases/$(database)/documents/clients/$(data.clientId)
          )
          && get(
            /databases/$(database)/documents/clients/$(data.clientId)
          ).data.tenantId == data.tenantId
          && get(
            /databases/$(database)/documents/clients/$(data.clientId)
          ).data.status == 'active'
          && get(
            /databases/$(database)/documents/clients/$(data.clientId)
          ).data.name == data.clientName
        );
    }

    function validPermissions(permissions) {
      return permissions.keys().hasOnly([
          'view', 'create', 'update', 'delete'
        ])
        && permissions.keys().hasAll([
          'view', 'create', 'update', 'delete'
        ])
        && permissions.view is bool
        && permissions.create is bool
        && permissions.update is bool
        && permissions.delete is bool;
    }

    // Valida a associação criada na mesma transação.
    function validOwnerMembership(tenantId) {
      return existsAfter(memberPath(tenantId, request.auth.uid))
        && getAfter(memberPath(tenantId, request.auth.uid)).data.userId
          == request.auth.uid
        && getAfter(memberPath(tenantId, request.auth.uid)).data.tenantId
          == tenantId
        && getAfter(memberPath(tenantId, request.auth.uid)).data.role
          == 'owner'
        && getAfter(memberPath(tenantId, request.auth.uid)).data.active
          == true;
    }

    // Valida a organização criada na mesma transação.
    function validNewTenant(tenantId) {
      return existsAfter(tenantPath(tenantId))
        && getAfter(tenantPath(tenantId)).data.ownerId
          == request.auth.uid
        && getAfter(tenantPath(tenantId)).data.status
          == 'active';
    }

    // Perfis individuais.
    match /users/{userId} {
      allow read: if isAuthenticated()
        && request.auth.uid == userId;

      // Permite ao administrador localizar um usuÃ¡rio jÃ¡ cadastrado
      // pelo e-mail para associÃ¡-lo Ã  organizaÃ§Ã£o.
      allow list: if isAuthenticated()
        && request.query.limit <= 1;

      allow create, update: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'name', 'email', 'photoURL', 'active',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.active == true;

      allow delete: if false;
    }

    // Organizações.
    match /tenants/{tenantId} {

      allow read: if isActiveMember(tenantId);

      allow create: if isAuthenticated()
        && request.resource.data.keys().hasOnly([
          'name',
          'document',
          'slug',
          'ownerId',
          'status',
          'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 100
        && request.resource.data.document is string
        && request.resource.data.document.matches('^[0-9]{14}$')
        && request.resource.data.slug is string
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'active'
        && validOwnerMembership(tenantId);

      // Alterações administrativas serão implementadas depois.
      allow update, delete: if false;
    }

    // Associação de usuários.
    match /tenantMembers/{memberId} {

      allow read: if isAuthenticated()
        && (
          resource.data.userId == request.auth.uid
          || isTenantAdmin(resource.data.tenantId)
        );


allow create: if isAuthenticated()
  && memberId == (
    request.resource.data.tenantId + '_' + request.auth.uid
  )
  && (
    // Criação do proprietário durante o onboarding.
    (
      request.resource.data.keys().hasOnly([
        'tenantId', 'userId', 'role', 'active', 'createdAt'
      ])
      && request.resource.data.userId == request.auth.uid
      && request.resource.data.role == 'owner'
      && request.resource.data.active == true
      && validNewTenant(request.resource.data.tenantId)
    )

    ||

    // Entrada de um novo membro por convite.
    (
        request.resource.data.keys().hasOnly([
          'tenantId', 'userId', 'email', 'role', 'permissions', 'active',
          'createdAt', 'invitationId'
        ])
        && request.resource.data.keys().hasAll([
          'tenantId', 'userId', 'email', 'role', 'permissions', 'active',
          'createdAt', 'invitationId'
        ])
      && request.resource.data.userId == request.auth.uid
      && request.resource.data.tenantId is string
        && request.resource.data.email == request.auth.token.email
      && request.resource.data.invitationId is string
      && request.resource.data.role in [
        'admin', 'manager', 'employee'
      ]
        && validPermissions(request.resource.data.permissions)
      && request.resource.data.active == true
      && request.resource.data.createdAt == request.time
      && exists(
        /databases/$(database)/documents/invitations/$(request.resource.data.invitationId)
      )
      && get(
        /databases/$(database)/documents/invitations/$(request.resource.data.invitationId)
      ).data.status == 'pending'
      && get(
        /databases/$(database)/documents/invitations/$(request.resource.data.invitationId)
      ).data.expiresAt > request.time
      && get(
        /databases/$(database)/documents/invitations/$(request.resource.data.invitationId)
      ).data.tenantId == request.resource.data.tenantId
      && get(
        /databases/$(database)/documents/invitations/$(request.resource.data.invitationId)
      ).data.role == request.resource.data.role
       && get(
         /databases/$(database)/documents/invitations/$(request.resource.data.invitationId)
       ).data.invitedEmail == request.auth.token.email
       && get(
         /databases/$(database)/documents/invitations/$(request.resource.data.invitationId)
       ).data.permissions == request.resource.data.permissions
      && get(
        /databases/$(database)/documents/tenants/$(request.resource.data.tenantId)
      ).data.status == 'active'
      && getAfter(
        /databases/$(database)/documents/invitations/$(request.resource.data.invitationId)
      ).data.status == 'accepted'
      && getAfter(
        /databases/$(database)/documents/invitations/$(request.resource.data.invitationId)
      ).data.acceptedBy == request.auth.uid
    )
  );


// O código funciona como uma credencial de acesso ao convite.
// Não permitimos listar todos os convites.
  allow update: if isAuthenticated()
    && isTenantAdmin(resource.data.tenantId)
    && resource.data.role != 'owner'
    && resource.data.userId != request.auth.uid
    && request.resource.data.diff(resource.data).affectedKeys()
      .hasOnly(['name', 'role', 'permissions', 'active'])
    && request.resource.data.tenantId == resource.data.tenantId
    && request.resource.data.userId == resource.data.userId
    && request.resource.data.email == resource.data.email
    && request.resource.data.role in [
      'admin', 'manager', 'employee'
    ]
    && validPermissions(request.resource.data.permissions)
    && request.resource.data.active == true;

  allow delete: if isAuthenticated()
    && isTenantAdmin(resource.data.tenantId)
    && resource.data.role != 'owner'
    && resource.data.userId != request.auth.uid;

  allow create: if isAuthenticated()
    && isTenantAdmin(request.resource.data.tenantId)
    && memberId == (
      request.resource.data.tenantId + '_' + request.resource.data.userId
    )
    && request.resource.data.keys().hasOnly([
      'tenantId', 'userId', 'name', 'email', 'role', 'permissions',
      'active', 'createdAt'
    ])
    && request.resource.data.userId is string
    && request.resource.data.name is string
    && request.resource.data.name.size() >= 2
    && request.resource.data.email is string
    && request.resource.data.role in [
      'admin', 'manager', 'employee'
    ]
    && validPermissions(request.resource.data.permissions)
    && request.resource.data.active == true
    && request.resource.data.createdAt == request.time
    && exists(
      /databases/$(database)/documents/users/$(request.resource.data.userId)
    )
    && get(
      /databases/$(database)/documents/users/$(request.resource.data.userId)
    ).data.email == request.resource.data.email;

  // Ativa o prÃ©-cadastro quando o usuÃ¡rio finalmente cria a conta.
  allow create: if isAuthenticated()
    && memberId == (
      request.resource.data.tenantId + '_' + request.auth.uid
    )
    && request.resource.data.keys().hasOnly([
      'tenantId', 'userId', 'name', 'email', 'role', 'permissions',
      'active', 'pendingRegistrationId', 'createdAt'
    ])
    && request.resource.data.userId == request.auth.uid
    && request.resource.data.name is string
    && request.resource.data.name.size() >= 2
    && request.resource.data.email == request.auth.token.email
    && request.resource.data.role in [
      'admin', 'manager', 'employee'
    ]
    && validPermissions(request.resource.data.permissions)
    && request.resource.data.active == true
    && request.resource.data.pendingRegistrationId is string
    && request.resource.data.createdAt == request.time
    && exists(
      /databases/$(database)/documents/pendingTenantMembers/$(request.resource.data.pendingRegistrationId)
    )
    && get(
      /databases/$(database)/documents/pendingTenantMembers/$(request.resource.data.pendingRegistrationId)
    ).data.status == 'pending'
    && get(
      /databases/$(database)/documents/pendingTenantMembers/$(request.resource.data.pendingRegistrationId)
    ).data.tenantId == request.resource.data.tenantId
    && get(
      /databases/$(database)/documents/pendingTenantMembers/$(request.resource.data.pendingRegistrationId)
    ).data.email == request.resource.data.email
    && get(
      /databases/$(database)/documents/pendingTenantMembers/$(request.resource.data.pendingRegistrationId)
    ).data.role == request.resource.data.role
    && get(
      /databases/$(database)/documents/pendingTenantMembers/$(request.resource.data.pendingRegistrationId)
    ).data.permissions == request.resource.data.permissions;

    }

    match /pendingTenantMembers/{pendingMemberId} {
      allow create: if isAuthenticated()
        && isTenantAdmin(request.resource.data.tenantId)
        && request.resource.data.keys().hasOnly([
          'tenantId', 'name', 'email', 'role', 'permissions',
          'status', 'createdBy', 'createdAt'
        ])
        && request.resource.data.tenantId is string
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.role in [
          'admin', 'manager', 'employee'
        ]
        && validPermissions(request.resource.data.permissions)
        && request.resource.data.status == 'pending'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;

      allow get: if isAuthenticated()
        && (
          resource.data.email == request.auth.token.email
          || isTenantAdmin(resource.data.tenantId)
        );

      allow list: if isAuthenticated()
        && (
          (
            request.auth.token.email is string
            && resource.data.email == request.auth.token.email
            && resource.data.status == 'pending'
          )
          || isTenantAdmin(resource.data.tenantId)
        );

      allow update: if (
        isAuthenticated()
        && resource.data.email == request.auth.token.email
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'userId', 'acceptedAt'])
        && request.resource.data.status == 'accepted'
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.acceptedAt == request.time
      ) || (
        isAuthenticated()
        && isTenantAdmin(resource.data.tenantId)
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'email', 'role', 'permissions'])
        && request.resource.data.role in [
          'admin', 'manager', 'employee'
        ]
        && validPermissions(request.resource.data.permissions)
      );

      allow delete: if isAuthenticated()
        && isTenantAdmin(resource.data.tenantId)
        && resource.data.status == 'pending';
    }

    // Registro interno de CNPJs.
    match /tenantDocuments/{documentId} {

      allow create: if isAuthenticated()
        && documentId.matches('^[0-9]{14}$')
        && request.resource.data.keys().hasOnly([
          'tenantId',
          'ownerId',
          'createdAt'
        ])
        && request.resource.data.ownerId == request.auth.uid
        && validNewTenant(request.resource.data.tenantId)
        && validOwnerMembership(request.resource.data.tenantId);

      allow read, update, delete: if false;
    }

    // Convites: serão implementados em outra etapa.

match /invitations/{invitationId} {

  allow create: if isAuthenticated()
    && request.resource.data.keys().hasOnly([
      'tenantId',
      'invitedEmail',
      'role',
      'permissions',
      'status',
      'invitedBy',
      'createdAt',
      'expiresAt'
    ])
    && request.resource.data.keys().hasAll([
      'tenantId',
      'invitedEmail',
      'role',
      'permissions',
      'status',
      'invitedBy',
      'createdAt',
      'expiresAt'
    ])
    && request.resource.data.tenantId is string
    && request.resource.data.invitedEmail is string
    && request.resource.data.invitedEmail.size() > 3
    && isTenantAdmin(request.resource.data.tenantId)
    && request.resource.data.invitedBy == request.auth.uid
    && request.resource.data.role in [
      'admin',
      'manager',
      'employee'
    ]
    && validPermissions(request.resource.data.permissions)
    && request.resource.data.status == 'pending'
    && request.resource.data.createdAt is timestamp
    && request.resource.data.expiresAt is timestamp
    && request.resource.data.createdAt <= request.time
    && request.resource.data.createdAt
       >= request.time - duration.value(5, 'm')
    && request.resource.data.expiresAt
       > request.resource.data.createdAt
    && request.resource.data.expiresAt
       <= request.time + duration.value(49, 'h');

  allow get: if isAuthenticated();
  allow list: if isAuthenticated()
    && request.auth.token.email is string
    && resource.data.invitedEmail == request.auth.token.email
    && resource.data.status == 'pending';

  allow update: if isAuthenticated()
    && resource.data.status == 'pending'
    && resource.data.expiresAt > request.time
    && resource.data.tenantId is string
    && resource.data.role in ['admin', 'manager', 'employee']
    && request.resource.data.diff(resource.data)
      .affectedKeys().hasOnly([
        'status', 'acceptedBy', 'acceptedAt'
      ])
    && request.resource.data.status == 'accepted'
    && request.resource.data.acceptedBy == request.auth.uid
    && request.resource.data.acceptedAt == request.time
    && existsAfter(
      memberPath(resource.data.tenantId, request.auth.uid)
    )
    && getAfter(
      memberPath(resource.data.tenantId, request.auth.uid)
    ).data.userId == request.auth.uid
    && getAfter(
      memberPath(resource.data.tenantId, request.auth.uid)
    ).data.role == resource.data.role
     && getAfter(
       memberPath(resource.data.tenantId, request.auth.uid)
     ).data.email == resource.data.invitedEmail
     && getAfter(
       memberPath(resource.data.tenantId, request.auth.uid)
     ).data.permissions == resource.data.permissions
    && getAfter(
      memberPath(resource.data.tenantId, request.auth.uid)
    ).data.invitationId == invitationId
    && getAfter(
      memberPath(resource.data.tenantId, request.auth.uid)
    ).data.active == true
    && getAfter(
      memberPath(resource.data.tenantId, request.auth.uid)
    ).data.createdAt == request.time;

  allow delete: if false;
}


    function validTask(data) {
      return data.keys().hasAll([
          'tenantId', 'projectId', 'title', 'description',
          'assignedTo', 'status', 'priority', 'dueDate',
          'completedAt', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'tenantId', 'projectId', 'title', 'description',
          'assignedTo', 'status', 'priority', 'dueDate',
          'completedAt', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.tenantId is string
        && data.projectId is string
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 150
        && data.description is string
        && data.description.size() <= 3000
        && (
          data.assignedTo == null
          || data.assignedTo is string
        )
        && data.status in [
          'pending', 'in_progress', 'completed', 'cancelled'
        ]
        && data.priority in [
          'low', 'medium', 'high', 'critical'
        ]
        && (
          data.dueDate == null
          || data.dueDate is timestamp
        )
        && (
          data.completedAt == null
          || data.completedAt is timestamp
        )
        && data.createdBy is string
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validTaskProject(data) {
      return exists(
        /databases/$(database)/documents/projects/$(data.projectId)
      )
      && get(
        /databases/$(database)/documents/projects/$(data.projectId)
      ).data.tenantId == data.tenantId;
    }

    match /tasks/{taskId} {

      allow read: if canProjectAction(
        resource.data.tenantId, 'view'
      );

      allow create: if validTask(request.resource.data)
        && canProjectAction(
          request.resource.data.tenantId, 'create'
        )
        && validTaskProject(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.completedAt == null
        && request.resource.data.createdAt <= request.time
        && request.resource.data.createdAt
          >= request.time - duration.value(5, 'm')
        && request.resource.data.updatedAt
          == request.resource.data.createdAt;

      allow update: if canProjectAction(
          resource.data.tenantId, 'update'
        )
        && validTask(request.resource.data)
        && request.resource.data.tenantId == resource.data.tenantId
        && request.resource.data.projectId == resource.data.projectId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt >= resource.data.updatedAt
        && request.resource.data.updatedAt <= request.time
        && validTaskProject(request.resource.data);

      allow delete: if canProjectAction(
        resource.data.tenantId, 'delete'
      );
    }


    // Bloqueio padrão.
    match /projects/{projectId} {

      allow read: if canProjectAction(
        resource.data.tenantId,
        'view'
      );

      allow create: if validProject(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt <= request.time
        && request.resource.data.createdAt
          >= request.time - duration.value(5, 'm')
        && request.resource.data.updatedAt
          == request.resource.data.createdAt
        && validProjectResponsible(
          request.resource.data.tenantId,
          request.resource.data.responsibleUserId
        )
        && validProjectClient(request.resource.data)
        && canProjectAction(
          request.resource.data.tenantId,
          'create'
        );

      allow update: if canProjectAction(
          resource.data.tenantId,
          'update'
        )
        && validProject(request.resource.data)
        && validProjectClient(request.resource.data)
        && request.resource.data.tenantId
          == resource.data.tenantId
        && request.resource.data.createdBy
          == resource.data.createdBy
        && request.resource.data.createdAt
          == resource.data.createdAt
        && request.resource.data.updatedAt
          >= resource.data.updatedAt
        && request.resource.data.updatedAt
          <= request.time;

      allow delete: if canProjectAction(
        resource.data.tenantId,
        'delete'
      );
    }


    // Clientes: validação do formato persistido pelo ClientService.
    function validClientAddress(address) {
      return address is map
        && address.keys().hasAll([
          'zipCode', 'street', 'number', 'complement',
          'neighborhood', 'city', 'state'
        ])
        && address.keys().hasOnly([
          'zipCode', 'street', 'number', 'complement',
          'neighborhood', 'city', 'state'
        ])
        && address.zipCode is string && address.zipCode.size() <= 9
        && address.street is string && address.street.size() <= 200
        && address.number is string && address.number.size() <= 30
        && address.complement is string && address.complement.size() <= 150
        && address.neighborhood is string && address.neighborhood.size() <= 120
        && address.city is string && address.city.size() <= 120
        && address.state is string && address.state.size() <= 2;
    }

    function validClient(data) {
      return data.keys().hasAll([
          'tenantId', 'type', 'name', 'document', 'email', 'phone',
          'address', 'status', 'notes', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'tenantId', 'type', 'name', 'document', 'email', 'phone',
          'address', 'status', 'notes', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.tenantId is string && data.tenantId.size() > 0
        && data.type in ['individual', 'company']
        && data.name is string
        && data.name.size() > 0 && data.name.size() <= 150
        && data.document is string
        && (
          data.document == ''
          || (data.type == 'individual' && data.document.matches('^[0-9]{11}$'))
          || (data.type == 'company' && data.document.matches('^[0-9A-Z]{12}[0-9]{2}$'))
        )
        && data.email is string && data.email.size() <= 254
        && data.phone is string && data.phone.size() <= 30
        && validClientAddress(data.address)
        && data.status in ['active', 'inactive']
        && data.notes is string && data.notes.size() <= 3000
        && data.createdBy is string
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /clients/{clientId} {
      allow get, list: if canProjectAction(resource.data.tenantId, 'view');

      allow create: if validClient(request.resource.data)
        && canProjectAction(request.resource.data.tenantId, 'create')
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt <= request.time
        && request.resource.data.createdAt >= request.time - duration.value(5, 'm')
        && request.resource.data.updatedAt == request.resource.data.createdAt;

      allow update: if canProjectAction(resource.data.tenantId, 'update')
        && validClient(request.resource.data)
        && request.resource.data.tenantId == resource.data.tenantId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt >= resource.data.updatedAt
        && request.resource.data.updatedAt <= request.time;

      allow delete: if canProjectAction(resource.data.tenantId, 'delete');
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
